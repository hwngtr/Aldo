# Aldo reads these from the shell, or from ~/.config/aldo/.env.
# A variable already set in the shell wins over the file.

# Aldo writes this file for you: the first run of `aldo` asks for these, and
# `aldo login` / `aldo logout` manage them. Edit it by hand only if you prefer.

# A Discogs personal access token, from https://www.discogs.com/settings/developers
# Optional: without it, searches report Discogs as "not configured" and
# downloads are untagged.
ALDO_DISCOGS_TOKEN=

# SoulSeek. The account is created on first use; there is no signup step.
ALDO_SLSK_USERNAME=
ALDO_SLSK_PASSWORD=
ALDO_SLSK_SHARED=/home/you/Music

# Optional: a SOCKS5 or HTTP proxy for the metadata sources only. SoulSeek owns
# its own socket and cannot be proxied.
# ALDO_PROXY=socks5://127.0.0.1:9050

# Optional: how long a search waits for peers, and the port they reach you on.
# Forwarding the port gives better results.
# ALDO_SLSK_TIMEOUT=8
# ALDO_SLSK_PORT=2234

# Optional: a different database directory or music folder. The music folder is
# created when it is the default and missing; a path you type must already exist.
# ALDO_DATA_DIR=/home/you/.local/share/aldo
# ALDO_LIBRARY_ROOT=/home/you/Music
